# ==============================================================================
# APPLICATION
# ==============================================================================
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
BASE_URL=http://localhost:8000

# ==============================================================================
# DATABASE — PostgreSQL (pgvector/pgvector:pg16)
# ==============================================================================
# Format: postgresql+asyncpg://user:password@host:port/dbname
POSTGRES_USER=reslens_user
POSTGRES_PASSWORD=reslens_password
POSTGRES_DB=ResLens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://reslens_user:reslens_password@postgres:5432/ResLens

# For Alembic (sync driver — used only for migrations)
DATABASE_URL_SYNC=postgresql://reslens_user:reslens_password@postgres:5432/ResLens

# Pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ==============================================================================
# PGADMIN (local dev only)
# ==============================================================================
PGADMIN_DEFAULT_EMAIL=your-email@example.com
PGADMIN_DEFAULT_PASSWORD=your-pgadmin-password
PGADMIN_PORT=5050

# ==============================================================================
# JWT
# ==============================================================================
JWT_SECRET_KEY=change-this-to-another-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================================================
# STORAGE — Cloudflare R2 / S3-compatible
# ==============================================================================
R2_ACCOUNT_ID=your-r2-account-id
R2_BUCKET=researchrag-papers
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
PRESIGN_EXPIRY_SECONDS=900

# ==============================================================================
# LLM
# ==============================================================================
OPENAI_API_KEY=your-openai-api-key
CHAT_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-small
MAX_CONTEXT_TURNS=20
SUMMARY_EVERY_K_TURNS=10

# ==============================================================================
# EMAIL — Resend
# ==============================================================================
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM_ADDRESS=noreply@researchrag.example.com
EMAIL_FROM_NAME=ResearchRAG Platform

# ==============================================================================
# SCHOLAR APIs
# ==============================================================================
OPENALEX_BASE_URL=https://api.openalex.org
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
UNPAYWALL_EMAIL=your-email@example.com
SCHOLAR_TIMEOUT_SECONDS=10

# ==============================================================================
# RAG SERVICE (external)
# ==============================================================================
RAG_SERVICE_URL=http://localhost:8001
RAG_SERVICE_API_KEY=your-rag-service-api-key
RAG_SERVICE_TIMEOUT_SECONDS=120

# ==============================================================================
# RATE LIMITING (requests / window_seconds)
# ==============================================================================
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW=900
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_UPLOAD_WINDOW=3600
RATE_LIMIT_DISCOVERY=30
RATE_LIMIT_DISCOVERY_WINDOW=60
RATE_LIMIT_GENERAL=120
RATE_LIMIT_GENERAL_WINDOW=60

# ==============================================================================
# STATS CACHE
# ==============================================================================
STATS_CACHE_TTL_SECONDS=300