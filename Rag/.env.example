# ============================================================
# RAPTOR RAG — Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to git
# ============================================================


# ── Qdrant ───────────────────────────────────────────────────
# Mode: false = local embedded (dev), true = server (prod)
QDRANT_USE_SERVER=false
QDRANT_HOST=localhost
QDRANT_PORT=6333


# ── Embedding Models ─────────────────────────────────────────
# These are fixed — do not change unless you re-embed everything
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# SPARSE_MODEL=prithivida/Splade_PP_En_V1


# ── Phase 3: RAPTOR Summarization ────────────────────────────
# Model used ONLY at ingest time to build the RAPTOR tree
# Not used at query time
# Supports any LiteLLM model string

# Primary summarization model
SUMMARIZER_PRIMARY_MODEL=gemini/gemini-2.5-flash

# Fallback chain (tried in order if primary fails)
SUMMARIZER_FALLBACK_1=gemini/gemini-2.0-flash
SUMMARIZER_FALLBACK_2=groq/llama-3.1-8b-instant
SUMMARIZER_FALLBACK_3=groq/gemma2-9b-it

# Summarizer API keys
# Gemini keys for summarization (rotate on rate limit)
SUMMARIZER_GEMINI_API_KEY=your_gemini_key_here
SUMMARIZER_GEMINI_API_KEY_2=
SUMMARIZER_GEMINI_API_KEY_3=

# Groq key for summarization fallback (free at console.groq.com)
SUMMARIZER_GROQ_API_KEY=


# ── Phase 6: Answer Generation ────────────────────────────────
# Model used at query time to generate answers
# BYOK: user provides their own model + key via API request
# System default: used when user provides no key

# System default primary generation model
GENERATION_PRIMARY_MODEL=gemini/gemini-2.0-flash

# System default fallback chain
GENERATION_FALLBACK_1=gemini/gemini-2.0-flash
GENERATION_FALLBACK_2=gemini/gemini-2.5-flash
GENERATION_FALLBACK_3=groq/llama-3.1-70b-versatile
GENERATION_FALLBACK_4=groq/llama-3.1-8b-instant
GENERATION_FALLBACK_5=openrouter/google/gemini-2.0-flash-exp:free

# System Gemini keys (rotate on rate limit)
# Add multiple keys to increase throughput
GEMINI_API_KEY=your_primary_gemini_key_here
GEMINI_API_KEY_1=your_primary_gemini_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# System Groq keys (rotate on rate limit)
# Free at console.groq.com
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# OpenRouter (free tier available at openrouter.ai)
OPENROUTER_API_KEY=

# BYOK keys — user provided via API (leave empty, set at runtime)
# These are accepted from API request headers, not from .env
# Listed here only for documentation
# GENERATION_BYOK_MODEL=      (set by user in API request)
# GENERATION_BYOK_API_KEY=    (set by user in API request)

# OpenAI (BYOK only, no system default)
OPENAI_API_KEY=

# Anthropic (BYOK only, no system default)
ANTHROPIC_API_KEY=

# Generation parameters
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=2048


# ── Ollama (optional, for local models) ──────────────────────
# Only needed if using ollama/* models in fallback chains
OLLAMA_BASE_URL=http://localhost:11434


# ── Logging ──────────────────────────────────────────────────
# debug | info | warning | error
LOG_LEVEL=info