# Copy this to .env and fill in your values

# BYOK API Keys (provide at least one)
GEMINI_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# Which LLM to use for generation
# Options: gemini, openai, anthropic, local
GENERATION_LLM_PROVIDER=gemini
GENERATION_LLM_MODEL=gemini-2.5-pro

# Ollama (for local summarization)
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant (local by default)
QDRANT_HOST=localhost
QDRANT_PORT=6333