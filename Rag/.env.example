# Copy this to .env and fill in your values

# BYOK API Keys (provide at least one)
GEMINI_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# Which LLM to use for generation
# Options: gemini, openai, anthropic, local
GENERATION_LLM_PROVIDER=gemini
GENERATION_LLM_MODEL=gemini-2.5-pro

# ── Summarizer (Phase 3 RAPTOR tree building) ──────────────────────────────
# Primary model
SUMMARIZER_PRIMARY_MODEL=gemini/gemini-2.5-flash

# Fallback chain (tried in order if primary fails)
SUMMARIZER_FALLBACK_1=gemini/gemini-2.0-flash
SUMMARIZER_FALLBACK_2=groq/llama-3.1-8b-instant
SUMMARIZER_FALLBACK_3=groq/gemma2-9b-it

# API Keys
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here   

# Qdrant mode
# false = local embedded (development)
# true  = server mode (production, run: docker run qdrant/qdrant)
QDRANT_USE_SERVER=false
QDRANT_HOST=localhost
QDRANT_PORT=6333







# ── Generation (Phase 6 — BYOK) ────────────────────────────────────────────
# User brings their own key (BYOK)
# Set these to use your own model/key
# If not set, system falls back to default keys below
GENERATION_BYOK_MODEL=
GENERATION_BYOK_API_KEY=

# System default primary model
GENERATION_PRIMARY_MODEL=gemini/gemini-2.0-flash

# Fallback chain
GENERATION_FALLBACK_1=gemini/gemini-2.0-flash
GENERATION_FALLBACK_2=gemini/gemini-2.5-flash
GENERATION_FALLBACK_3=groq/llama-3.1-70b-versatile
GENERATION_FALLBACK_4=groq/llama-3.1-8b-instant
GENERATION_FALLBACK_5=openrouter/google/gemini-2.0-flash-exp:free

# Multiple Gemini API keys (rotate on rate limit)
GEMINI_API_KEY=your_primary_gemini_key
GEMINI_API_KEY_1=your_primary_gemini_key
GEMINI_API_KEY_2=your_second_gemini_key
GEMINI_API_KEY_3=your_third_gemini_key

# Groq keys
GROQ_API_KEY=your_groq_key
GROQ_API_KEY_1=your_groq_key
GROQ_API_KEY_2=your_second_groq_key

# OpenRouter (free tier available)
OPENROUTER_API_KEY=your_openrouter_key

# OpenAI (BYOK)
OPENAI_API_KEY=

# Anthropic (BYOK)
ANTHROPIC_API_KEY=

# Generation settings
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=2048